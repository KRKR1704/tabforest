# ── Azure OpenAI (PRE-R1, yours, already set) ─────────────────
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=replace-with-your-azure-openai-key
AZURE_OPENAI_CHAT_DEPLOYMENT=your-chat-deployment-name
AZURE_OPENAI_EMBED_DEPLOYMENT=your-embedding-deployment-name
AZURE_OPENAI_API_VERSION=2024-10-21

# ── Tiger Cloud (PRE-P2, from P) ──────────────────────────────
# Full URL, must end with ?sslmode=require (a remote database without it is refused at startup).
# Real values live only in your own .env (git-ignored), the App Service settings and the GitHub secrets.
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME?sslmode=require

# ── Entra ID (PRE-P3, from P) ─────────────────────────────────
# The client ID is public (SPEC §12). v2 access tokens carry it in aud, so it is also the
# audience the API checks (X13); the extension still requests api://tabforest/user_impersonation.
ENTRA_TENANT=common
ENTRA_CLIENT_ID=84bf8d79-85c2-463d-a8eb-c0a4d22bdb24
ENTRA_API_AUDIENCE=84bf8d79-85c2-463d-a8eb-c0a4d22bdb24

# ── Fallback login (only if Entra is cut at D-6) ──────────────
# FALLBACK_ACCOUNTS is JSON {"email": "<argon2id hash>"}; make a hash with
#   uv run python scripts/hash_password.py
FALLBACK_LOGIN=false
JWT_SECRET=replace-with-at-least-32-random-characters
FALLBACK_ACCOUNTS={"someone@example.com": "$argon2id$replace-with-the-output-of-hash_password.py"}

# ── App Service / telemetry (PRE-P1, from P) ──────────────────
API_BASE_URL=https://tabforest.azurewebsites.net
# Leave empty to run without telemetry; the portal's Application Insights page has the real string.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ── CORS (D's fixed extension ID) ─────────────────────────────
ALLOWED_EXTENSION_ORIGIN=chrome-extension://nldemblgfgcaolkpkajdbefjfnileeoi

# ── Local dev ─────────────────────────────────────────────────
# dev = accept the X-Dev-User header (BUILD_TASKS §4.1)
AUTH_MODE=dev
