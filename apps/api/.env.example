# ── Azure OpenAI (PRE-R1, yours, already set) ─────────────────
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBED_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# ── Tiger Cloud (PRE-P2, from P) ──────────────────────────────
# Full URL, must end with ?sslmode=require
DATABASE_URL=

# ── Entra ID (PRE-P3, from P) ─────────────────────────────────
ENTRA_TENANT=common
ENTRA_CLIENT_ID=
ENTRA_API_AUDIENCE=api://tabforest

# ── App Service / telemetry (PRE-P1, from P) ──────────────────
API_BASE_URL=https://tabforest-api.azurewebsites.net
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ── CORS (D's fixed extension ID) ─────────────────────────────
ALLOWED_EXTENSION_ORIGIN=chrome-extension://nldemblgfgcaolkpkajdbefjfnileeoi

# ── Local dev ─────────────────────────────────────────────────
# dev = accept the X-Dev-User header (BUILD_TASKS §4.1)
AUTH_MODE=dev
