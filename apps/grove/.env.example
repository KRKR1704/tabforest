# Copy to .env.local (never committed) or pass on the command line when building.
# Nothing here is a secret; do not put tokens or keys in these files.

# Anything but 0: every adapter uses its stand-in (the contracts/ examples). This is the default.
VITE_MOCK=1

# With VITE_MOCK=0: where the API is.
VITE_API_BASE_URL=http://localhost:8000

# With VITE_MOCK=0: the endpoints the server really serves; every other adapter stays on its
# stand-in. Leave it out to make all of them live.
# Names: me, grove, claims, contexts, timeline, sessions, privacy, memory, prune, work-context
VITE_LIVE_ENDPOINTS=me,grove

# Only for a local API started with AUTH_MODE=dev: sent as X-Dev-User when there is no token.
# The deployed API rejects this header.
# VITE_DEV_USER=452b6018-022d-5e0b-bd7c-101d3c412b79

# The grove motion layer: idle movement, depth shading and change animations.
# Set to 0 to go back to the plain grove.
# VITE_GROVE_MOTION=0
